# ==========================================================
# TEMPLATE ENVIRONMENT ERP TERA (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ==========================================================

# Gemini API Key untuk Virtual COO & Supplier Intelligence AI
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/app/apikey
# Atau gunakan "mock_api_key" untuk mode uji coba tanpa kuota/koneksi AI asli.
GEMINI_API_KEY=mock_api_key

# Database URL (Opsional: jika dikosongkan, aplikasi otomatis menggunakan SQLite lokal data/erp.sqlite)
# DATABASE_URL=
